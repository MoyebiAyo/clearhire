# ── Supabase (Week 1 — required) ──────────────────────────────────────────────
# Project Settings → API. The NEXT_PUBLIC_ prefix is required because the
# browser client needs these too (they are public by design; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client. Used for storage writes and
# server-side table writes inside authenticated API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider (Week 2 — not needed yet) ────────────────────────────────────
GROQ_API_KEY=
FALLBACK_AI_BASE_URL=
FALLBACK_AI_API_KEY=

# ── Email (Week 4 — not needed yet) ──────────────────────────────────────────
RESEND_API_KEY=

# ── Gmail intake (Week 5 — not needed yet) ───────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Reminder worker (Week 5 — not needed yet) ────────────────────────────────
CLOUDFLARE_WORKER_SHARED_SECRET=
